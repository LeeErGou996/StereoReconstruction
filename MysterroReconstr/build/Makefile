	$(MAKE) $(MAKESILENT) -f CMakeFiles/testtripletshow.dir/build.make CMakeFiles/testtripletshow.dir/test/testtripletshow.cpp.o
.PHONY : test/testtripletshow.cpp.o

test/testtripletshow.i: test/testtripletshow.cpp.i
.PHONY : test/testtripletshow.i

# target to preprocess a source file
test/testtripletshow.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/testtripletshow.dir/build.make CMakeFiles/testtripletshow.dir/test/testtripletshow.cpp.i
.PHONY : test/testtripletshow.cpp.i

test/testtripletshow.s: test/testtripletshow.cpp.s
.PHONY : test/testtripletshow.s

# target to generate assembly for a file
test/testtripletshow.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/testtripletshow.dir/build.make CMakeFiles/testtripletshow.dir/test/testtripletshow.cpp.s
.PHONY : test/testtripletshow.cpp.s

